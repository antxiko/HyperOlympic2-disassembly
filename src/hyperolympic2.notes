L 0x5246 MIRA_A_QUIEN_LE_TOCA_GASTAR_2
L 0x5266 MIRA_AL_PRIMERO_EN_JUEGO
L 0x5273 PASA_AL_JUGADOR_1
L 0x527F MIRA_EL_BIT_6
L 0x5319 SALTA_AL_SIGUIENTE_CAMPO
L 0x554C REPARTE_LO_QUE_CABE_2
L 0x56F9 MIRA_LA_PRUEBA_EN_CURSO
L 0x577B MIRA_EL_ESTADO_DEL_ATLETA_1
L 0x57D5 MUEVE_LA_VALLA_DEL_1
L 0x57E7 CORRE_EL_ATLETA_1
