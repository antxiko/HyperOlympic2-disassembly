D 0x7B9E 0x7BAB figura_del_salto_de_altura  Otra figura del decorado.
F 0x7B9E 8
D 0x7BAB 0x7BB6 ficha_del_atleta  La ficha que 0x7B53 copia siempre a 0xE120.
F 0x7BAB 8
D 0x7BB6 0x7BDB fichas_de_las_110_vallas  Cadena de tres fichas para 0xE130, 0xE140 y 0xE150.
F 0x7BB6 8
D 0x7BDB 0x7C0B fichas_de_relevo  Las fichas que 0x7A46 y el trozo de 0x7AF0 cargan encima de otra cuando la animacion cambia.
F 0x7BDB 8
D 0x7C0B 0x7C93 figuras_de_las_110_vallas  Las figuras del decorado de las pruebas de carrera, incluidas las vallas.
F 0x7C0B 8
D 0x7C93 0x7CAE fichas_de_la_jabalina  Cadena de dos fichas para 0xE130 y 0xE140.
F 0x7C93 8
D 0x7CAE 0x7CE7 figuras_de_la_jabalina  Las figuras del pasillo y la linea de nulo.
F 0x7CAE 8
D 0x7CE7 0x7D0C fichas_de_los_1500_metros  Cadena de tres fichas.
F 0x7CE7 8
D 0x7D0C 0x7D2B fichas_de_relevo_2  Dos fichas mas de relevo.
F 0x7D0C 8
D 0x7EF5 0x7F51 seno  El seno de 0 a 91 grados por 255, un byte por grado. Lo lee 0x7E53 con el angulo de lanzamiento.
F 0x7EF5 16
D 0x7FFE 0x8000 relleno  Los dos bytes que sobran del cartucho, a 0xFF.
F 0x7FFE 2

B 0x5A1B ==========  EL SALTO DE LA VALLA  ==========
B 0x5A1B Lo unico que las 110 vallas anaden a la carrera: mientras el atleta
B 0x5A1B corre, el bit 1 de 0xE0C5 pide saltar. El salto dura diez cuadros
B 0x5A1B (0x5A34) y mientras dura la postura es la 13; al final, la 6. Si al
B 0x5A1B acabar el atleta esta a menos de ocho columnas de una valla, se le
B 0x5A1B pone el bit 4 de 0xE028 o 0xE029, que es lo que le hace caer.
L 0x5A1B MIRA_EL_SALTO_DE_LA_VALLA
C 0x5A1C bit 4: el atleta viene de derribar una valla
C 0x5A22 con la cuenta de salto a cero no esta saltando
C 0x5A28 bit 1 de 0xE0C5: han pedido saltar
C 0x5A2D bit 0 de la ficha: el actor esta encendido
C 0x5A34 diez cuadros de salto
C 0x5A37 y el actor se enciende
C 0x5A3B la marca del jugador 1
C 0x5A40 o la del 2, segun de quien sea la ficha
C 0x5A47 hay marca nueva que pintar
C 0x5A4A y se gasta velocidad por saltar
L 0x5A4E GASTA_EL_SALTO
C 0x5A4E la cuenta de salto
C 0x5A4F postura 13 mientras dure
C 0x5A56 y la 6 en el ultimo cuadro
L 0x5A5B MIRA_SI_DERRIBA_LA_VALLA
C 0x5A5C ocho columnas de margen
C 0x5A60 0xE0B5 es el atleta del jugador 1
C 0x5A64 la valla que le toca al jugador 1
C 0x5A6C o la del jugador 2
L 0x5A71 MIRA_LA_VALLA
C 0x5A72 sin pulsacion apuntada no se mira
C 0x5A74 con la valla a cero no hay valla
C 0x5A77 con la valla a uno, ya esta derribada
C 0x5A7E la columna de la valla contra la del atleta
C 0x5A80 y ocho mas de margen por delante
C 0x5A86 con la postura 13 el atleta va por encima
C 0x5A8E la valla se pone en 0x012C
C 0x5A97 y el sprite en la fila 0x15
C 0x5A99 0xE0BA es el jugador 1
C 0x5AA2 bit 4: el atleta ha derribado la valla
L 0x5AA5 EL_ATLETA_HA_TROPEZADO
C 0x5AA6 con la cuenta a cero se levanta
C 0x5AA9 la cuenta del tropiezo
C 0x5AAA por encima de 0x13 la postura es la 13
C 0x5AB1 y por encima de 8, tambien
C 0x5AB6 trece bytes atras
C 0x5ABB cuatro bytes de velocidad
L 0x5ABD LIMPIA_LA_VELOCIDAD
C 0x5AC5 y la postura queda en la 14
L 0x5AD7 EL_ATLETA_SE_LEVANTA
C 0x5ad7 sin pulsacion no se levanta
C 0x5ADD doce bytes atras
C 0x5AE1 velocidad 0x032C
C 0x5AEA baja el bit de tropiezo
C 0x5AF1 la pulsacion del jugador 1
C 0x5AF7 0x14 cuadros de levantarse
C 0x5AFB y postura 6
L 0x5AFF APAGA_EL_SALTO
C 0x5AFF el actor se apaga
L 0x5B03 CORRE_SIN_SALTAR
C 0x5B03 0xE0BA es el jugador 1
C 0x5B0A mueve al atleta del jugador 1
C 0x5B0D y le gasta una pulsacion
L 0x5B1B CORRE_SIN_SALTAR_EL_2
C 0x5B1D mueve al atleta del jugador 2
C 0x5B20 y le gasta la suya
L 0x5B2C VUELVE_A_MIRAR_LA_VALLA
L 0x5B33 LA_VALLA_YA_ESTA_DERRIBADA
C 0x5B34 la columna de la valla caida
C 0x5B35 pasada la columna 0x62 ya no estorba
C 0x5B3A 0xE05C es el jugador 1
C 0x5B41 bit 2: el atleta ha pasado la valla

B 0x682A ==========  MOTOR DE LA JABALINA  ==========
B 0x682A Igual que el salto del cartucho hermano: se corre, se marca el angulo
B 0x682A con el boton y se suelta. La jabalina vuela con el trozo de 0x7D2B, y
B 0x682A el patron que se le sube (0x789E) cambia con la inclinacion.
C 0x682C la fila de sprites del objeto
C 0x682F dos sprites
L 0x6831 ESCONDE_EL_OBJETO
C 0x6838 fila 0xCF, o sea fuera de la pantalla
C 0x683C y el siguiente
L 0x6844 CORRE_CON_LA_JABALINA
C 0x6844 cuenta el angulo con el boton
C 0x6847 sonido de fondo de la carrerilla
C 0x684D la ficha del que juega
C 0x6850 la posicion de la jabalina
C 0x6854 once columnas por delante del atleta
C 0x685A y cinco filas por encima
C 0x685D la fila de sprites del objeto
C 0x6863 la postura del atleta
C 0x6867 las posturas 6 a 11 llevan jabalina en la mano
C 0x686D la tabla de patrones del atleta con jabalina
C 0x6878 los patrones del jugador 1
C 0x687F o los del 2
L 0x6885 MIRA_EL_SUELTE
C 0x6885 sube el patron de la jabalina
C 0x6889 la posicion del tiro
C 0x688F la marca del jugador 2
C 0x6892 pasada la columna 0x26C
C 0x6899 se acaba la carrerilla
L 0x689C JABALINA_EN_EL_AIRE
C 0x689C mueve el vuelo
C 0x689F mientras vuele, aqui se sigue
C 0x68A0 sonido 0x4E: la clavada
C 0x68A6 musica normal otra vez
L 0x68A9 PASA_A_LA_FASE_1
L 0x68AE ESPERA_A_QUE_ACABE_EL_GOLPE
C 0x68AE mientras el canal 3 suene, se espera
C 0x68B3 fase 2
C 0x68B8 y a la animacion final
L 0x68BB MIRA_EL_RESULTADO
C 0x68BB sin resultado no hay animacion
L 0x68C3 ELIGE_EL_PATRON_DE_LA_JABALINA
C 0x68C3 la velocidad vertical del tiro
C 0x68CB con el bit alto puesto, la jabalina baja
C 0x68CF modo 2 de la musica: el silbido
C 0x68D8 se le quita el signo
L 0x68DB REPARTE_LA_INCLINACION
C 0x68DB por encima de 0x20F3 va casi vertical
C 0x68E4 y por debajo de 0x0CD2, casi horizontal
L 0x68ED AJUSTA_LA_INCLINACION
C 0x68ED bajando, los patrones van dos mas alla
L 0x68F3 SUBE_EL_PATRON_QUE_TOCA
C 0x68F3 el patron elegido
C 0x68F9 la tabla de patrones del objeto
L 0x6903 SUBE_EL_OBJETO
C 0x6903 al hueco de sprite de 0x1800
C 0x690A la fila de atributos del objeto
C 0x690D la posicion del objeto
C 0x6911 el puerto de datos del VDP
C 0x6916 dos sprites, que la jabalina ocupa dos
L 0x6918 UN_SPRITE_DE_LA_JABALINA
C 0x691C la fila, sumada a la de la lista
C 0x6924 la columna, igual
C 0x6930 y el patron 0, que es el que se acaba de subir
L 0x693A CORRE_Y_LANZA
C 0x693A con 0xE200 puesto ya esta lanzada
C 0x6940 postura 9, la de correr con la jabalina
C 0x6945 el boton del que juega
C 0x6948 bit 1: han soltado
C 0x694F el angulo, en BCD
C 0x6955 y su cuenta en binario
C 0x6958 el tope son 50 grados
L 0x695C SUELTA_LA_JABALINA
L 0x6961 SUENA_EL_LANZAMIENTO
C 0x6961 si el canal 3 esta libre
C 0x6967 suena el sonido 1
L 0x696C AVANZA_LA_JABALINA
C 0x696D sonido de fondo del vuelo
C 0x6973 solo en los cuadros impares
C 0x6979 avanza el tiro
L 0x69A6 SUMA_EL_AVANCE_DEL_VUELO
C 0x69A6 la columna del primer objeto
C 0x69AF el contador del vuelo
C 0x69B5 da la columna del atleta
C 0x69B8 fuera del tramo 0x90..0xBF
C 0x69C0 se cambia el patron de la jabalina
L 0x69C3 GUARDA_EL_AVANCE_DEL_VUELO
C 0x69C6 bit 0 de 0xE02C: intento acabado
L 0x69CF MIRA_SI_TERMINA_EL_VUELO
C 0x69CF pinta a los dos atletas
C 0x69D2 el avance acumulado
C 0x69D5 por debajo de 0xE0 aun vuela
C 0x69D8 y por encima de 0xF0 tampoco ha caido
C 0x4216 ronda 1 y prueba 1 de una tacada
C 0x421c viniendo de la demo no se toca la espera
C 0x4221 cuatro puntos de espera
C 0x4293 pinta el marco del marcador
C 0x4296 la prueba en curso
C 0x4299 en el salto de altura el turno va en otra casilla
C 0x43e7 el estado del atleta del jugador 2
C 0x43ed la velocidad del jugador 1
C 0x43f0 con 0x30 justo se usa la escala corta
C 0x4563 la marca sube dos en BCD
C 0x456a con acarreo al byte de arriba
C 0x48b3 el byte de abajo
C 0x48b5 sube 0x60 en BCD
C 0x48ba con acarreo al de arriba
C 0x4941 pinta la ficha del atleta
C 0x494a y salta a la ficha siguiente, 0x10 bytes mas alla
C 0x522c bit 1: el jugador 2 sigue en juego
C 0x5230 en las pruebas impares le toca al 1
C 0x5235 con velocidad no hace falta empujar
C 0x5266 bit 0: el jugador 1 sigue en juego
C 0x5269 y en las impares le toca a el
C 0x554c lo que cabe al de detras
C 0x5553 y lo que sobra al decorado
C 0x5561 la posicion del jugador 2
C 0x5596 al de delante se le quita lo arrastrado
C 0x5599 y se clava en 0x58
C 0x57d5 la velocidad del jugador 1
C 0x57d8 su estado
C 0x57db y la ficha de su valla
C 0x57e3 la pulsacion queda gastada
C 0x5873 la velocidad del jugador 2
C 0x5876 su estado
C 0x5879 y la ficha de su valla
C 0x5881 la pulsacion queda gastada
C 0x5b74 la postura que toca
C 0x5b77 en jabalina y altura la postura va cuatro bytes antes
C 0x5bf8 la ficha del que juega
C 0x5bfa en jabalina y altura se pinta de otra forma
C 0x5de9 el avance del cuadro
C 0x5df1 bit 7 de 0xE02E: el atleta va suelto
C 0x5df5 la marca del jugador 2
C 0x6990 la ficha del que juega
C 0x6994 la altura de este cuadro
C 0x6998 con la fila en 0xCF ya esta clavada en el suelo
C 0x6a8f el boton del que juega
C 0x6a92 bit 1: siguen apretando
C 0x6a99 el impulso acumulado
C 0x6a9c por debajo de 0x15 ya no baja mas
C 0x6a9e y se va gastando, en binario y en BCD
L 0x6AA4 MUEVE_EL_SALTO_DE_ALTURA
C 0x6aa4 la fase del salto
C 0x6aa8 bit 7: ya ha caido
C 0x6aab bit 6: esta en el aire
C 0x6ab2 solo en los cuadros pares
C 0x6ab5 sonido de fondo del salto
C 0x6abb avanza la parabola
C 0x6abe la columna del que juega
C 0x6ac2 la altura acumulada
C 0x6ac6 pasada la columna 0xD2 ya no avanza mas
C 0x6aca y se le suma el avance del cuadro
L 0x6ACF SUMA_LA_ALTURA_DEL_CUADRO
C 0x6ad1 la altura de este cuadro, cambiada de signo
C 0x6ad8 la velocidad vertical
C 0x6ae0 con el bit alto puesto, el atleta baja
C 0x6ae4 subiendo, el corte esta en 0x0500
C 0x6ae9 y bajando, en 0xFC00
C 0x6af2 de ahi sale la postura del vuelo
C 0x6af6 la postura del que juega
C 0x6b00 quince posturas mas abajo
C 0x6b05 la tabla de desplazamientos del salto
C 0x6b0b dos pares por postura
L 0x6B0F COLOCA_EL_SPRITE_DEL_SALTO
C 0x6b0f compara la fila con la del liston
C 0x6b12 y con la columna, para saber si lo ha tirado
C 0x6b18 la ronda entra en la cuenta de la fila
C 0x6b23 la marca que se acaba de saltar
L 0x6B4B MIRA_SI_HA_PASADO_EL_LISTON
C 0x6b4b la columna del que juega
C 0x6b4f pasada la columna 0xB0
C 0x6b56 bit 0 de 0xE201: ya esta al otro lado
L 0x6B58 MIRA_LA_CAIDA_DEL_SALTO
C 0x6b58 la postura del vuelo
C 0x6b5b solo la 0x11 cuenta como caida
C 0x6b5e la ficha del que juega
C 0x6b61 bit 0: viene del otro lado del liston
C 0x6b68 cayendo se admite hasta la fila 0x74
C 0x6b6d y subiendo, hasta la 0x82
L 0x6B70 CIERRA_EL_SALTO
C 0x6b70 la fase del salto
C 0x6b75 si no es la 1, el intento se da por acabado
C 0x6b7d bit 7 de 0xE201: se acabo el salto
L 0x7AB3 MONTA_LA_VALLA
C 0x7ab3 la figura de la valla
C 0x7aba la mitad de arriba va al papel de 0xE230
C 0x7ac1 y la de abajo al de 0xE270
C 0x7ac7 el ancho de la figura
C 0x7aca con 0xF8 se pasa a 0xF9
L 0x7AD2 MIRA_SI_LA_VALLA_CABE
C 0x7ad2 la columna del actor
C 0x7ad5 dentro del papel
C 0x7adc con 0xFF ahi ya no hay figura
C 0x7ae0 recalcula la direccion de VRAM
C 0x7ae3 y la guarda en la ficha
C 0x7aea la figura se pone a cero
C 0x7aed la cuenta de la valla del jugador 1
C 0x7af0 y la ficha que la releva
C 0x7af3 bit 5: es la valla del jugador 2
C 0x7af9 entonces la del 2
L 0x7AFD SUBE_LA_CUENTA_DE_LA_VALLA
C 0x7afd una valla mas
C 0x7aff con diez se acabaron las vallas
C 0x7b03 y se carga la ficha de relevo encima
L 0x7B0B PINTA_LA_VALLA
C 0x7b0b sube la mitad de arriba
C 0x7b0e y recalcula la direccion
L 0x7B11 PINTA_LA_MITAD_DE_ABAJO
C 0x7b12 la columna dentro de la fila
C 0x7b14 por debajo de la doce no se pinta
C 0x7b17 se lleva a la fila de abajo
C 0x7b1a y se fija la direccion
C 0x7b1d la cuenta de la valla del jugador 1
C 0x7b20 bit 5: la del jugador 2
L 0x7B27 MIRA_LA_VALLA_QUE_TOCA
C 0x7b27 con nueve vallas se acabo
C 0x7b2c a partir de la primera se pinta siempre
C 0x7b2e la columna
C 0x7b31 antes de la 0x14 no se pinta
C 0x7b35 y la parte baja de la direccion de VRAM
L 0x7B3C SUBE_LA_MITAD_DE_ABAJO
C 0x7b3c el papel de abajo
L 0x7B44 RECALCULA_LA_DIRECCION
C 0x7b44 la direccion de VRAM de la ficha
C 0x7b4a 0x14 columnas mas alla
C 0x7b4d menos la columna del actor
L 0x422E CARGA_LA_MARCA_A_BATIR
L 0x4234 AJUSTA_EL_INTENTO_DEL_1
L 0x4290 PINTA_EL_ROTULO_DE_DOS
L 0x4293 PINTA_EL_MARCO_Y_EL_TURNO
L 0x42DF GUARDA_LA_MARCA_A_BATIR
L 0x42E4 PINTA_LA_MARCA_A_BATIR
L 0x4338 PONE_LA_POSTURA_DE_ESPERA
L 0x433F MIRA_SI_HAY_TABLA_DE_INTENTOS
L 0x43E0 RECORTA_EL_ANGULO_2
L 0x43E7 MIRA_LA_MARCA_DE_LA_MAQUINA
L 0x4483 MIRA_EL_FIN_DEL_INTENTO_2
L 0x4488 PINTA_LA_UNIDAD
L 0x4495 MIRA_EL_OBJETO_QUE_VUELA
L 0x44AB PINTA_LA_LISTA_DE_INTENTOS
L 0x44BF BAJA_A_LA_FILA_QUE_TOCA
L 0x452E MARCA_EL_INTENTO_QUE_VALE
L 0x4563 SUBE_LA_MARCA_DOS
L 0x456D SUENA_EL_RECORD
L 0x4700 ESPERA_A_QUE_CALLE
L 0x486D RESULTADO_CLASIFICADO
L 0x4872 SUENA_LA_FANFARRIA
L 0x4876 CASILLA_DEL_CARTEL_2
